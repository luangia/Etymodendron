{
  "name": "etymodendron-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync-data": "node scripts/sync-data.mjs",
    "dev": "npm run sync-data && vite",
    "build": "npm run sync-data && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check-dist": "node scripts/check-dist.mjs",
    "deploy": "npm run build && npm run check-dist && wrangler pages deploy dist --project-name etymodendron --branch main"
  },
  "dependencies": {
    "d3": "^7.9.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.156.2"
  }
}
